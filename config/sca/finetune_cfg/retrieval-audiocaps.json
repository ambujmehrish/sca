{
 "run_cfg": {
  "default": "./config/sca/default_run_cfg.json",
  "new_params_name": []
 },
 "model_cfg": {
  "default": "./config/sca/default_model_cfg.json",
  "s_star_path": "${SCA_CACHE_ROOT}/s_star_ft_audiocaps.pt"
 },
 "data_cfg": {
  "train": [
   {
    "type": "annoindexed",
    "training": true,
    "name": "audiocaps_ret",
    "txt": "benchmark_eval/audiocaps_tva_annotation.json",
    "audio": "${DATA_ROOT}/AudioCaps/audios",
    "vision": "${DATA_ROOT}/AudioCaps/videos",
    "audio_sample_num": 1,
    "vision_format": "video_rawvideo",
    "vision_sample_num": 8,
    "task": "ret%tva",
    "epoch": 10,
    "n_workers": 8,
    "batch_size": 64
   }
  ],
  "val": [
   {
    "type": "annoindexed",
    "training": false,
    "name": "audiocaps_ret",
    "txt": "benchmark_eval/audiocaps_tva_annotation.json",
    "audio": "${DATA_ROOT}/AudioCaps/audios",
    "vision": "${DATA_ROOT}/AudioCaps/videos",
    "audio_sample_num": 1,
    "vision_format": "video_rawvideo",
    "vision_sample_num": 8,
    "task": "ret%tva",
    "n_workers": 8,
    "batch_size": 64
   }
  ]
 }
}