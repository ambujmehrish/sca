{
 "run_cfg": {
  "default": "./config/gram/default_run_cfg.json",
  "mode": "testing",
  "checkpoint": "${EVAL_CKPT}"
 },
 "model_cfg": {
  "default": "./config/gram/default_model_cfg.json",
  "vision_encoder_type": "evaclip01_giant",
  "ret_bidirection_evaluation": true,
  "itm_rerank_num": 50
 },
 "data_cfg": {
  "train": [
   {
    "type": "annoindexed",
    "training": false,
    "name": "msrvtt_ret",
    "txt": "datasets/annotations/msrvtt/descs_ret_test.json",
    "vision_transforms": "crop_flip",
    "vision_format": "video_rawvideo",
    "vision": "${DATA_ROOT}/MSRVTT_full/MSRVTT/videos/all",
    "audio": "${DATA_ROOT}/MSRVTT_full/audios",
    "vision_sample_num": 8,
    "audio_sample_num": 1,
    "task": "ret%tvasd",
    "n_workers": 8,
    "batch_size": 32,
    "depth": "${DATA_ROOT}/MSRVTT_full/MSRVTT/depth/all"
   }
  ],
  "val": [
   {
    "type": "annoindexed",
    "training": false,
    "name": "msrvtt_ret",
    "txt": "datasets/annotations/msrvtt/descs_ret_test.json",
    "vision_transforms": "crop_flip",
    "vision_format": "video_rawvideo",
    "vision": "${DATA_ROOT}/MSRVTT_full/MSRVTT/videos/all",
    "audio": "${DATA_ROOT}/MSRVTT_full/audios",
    "vision_sample_num": 8,
    "audio_sample_num": 1,
    "task": "ret%tvasd",
    "n_workers": 8,
    "batch_size": 32,
    "depth": "${DATA_ROOT}/MSRVTT_full/MSRVTT/depth/all"
   }
  ]
 }
}