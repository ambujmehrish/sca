{
 "run_cfg": {
  "default": "./config/gram/default_run_cfg.json",
  "mode": "testing",
  "checkpoint": "${EVAL_CKPT}"
 },
 "model_cfg": {
  "default": "./config/gram/default_model_cfg.json",
  "vision_encoder_type": "evaclip01_giant",
  "ret_bidirection_evaluation": true,
  "itm_rerank_num": 50,
  "max_caption_len": 70
 },
 "data_cfg": {
  "train": [
   {
    "type": "annoindexed",
    "training": false,
    "name": "vgg_ret",
    "txt": "benchmark_eval/vgg_tsne_annotation.json",
    "vision": "${VGG5K_ROOT}/videos",
    "audio": "${VGG5K_ROOT}/audios",
    "vision_format": "video_rawvideo",
    "vision_sample_num": 8,
    "audio_sample_num": 1,
    "task": "ret%tva",
    "n_workers": 8,
    "batch_size": 64
   }
  ],
  "val": [
   {
    "type": "annoindexed",
    "training": false,
    "name": "vgg_ret",
    "txt": "benchmark_eval/vgg_tsne_annotation.json",
    "vision": "${VGG5K_ROOT}/videos",
    "audio": "${VGG5K_ROOT}/audios",
    "vision_format": "video_rawvideo",
    "vision_sample_num": 8,
    "audio_sample_num": 1,
    "task": "ret%tva",
    "n_workers": 8,
    "batch_size": 64
   }
  ]
 }
}