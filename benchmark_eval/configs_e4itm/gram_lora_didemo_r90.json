{
 "run_cfg": {
  "default": "./config/gram/default_run_cfg.json",
  "mode": "testing",
  "checkpoint": "${EVAL_CKPT}"
 },
 "model_cfg": {
  "default": "./config/gram/default_model_cfg.json",
  "vision_encoder_type": "evaclip01_giant",
  "ret_bidirection_evaluation": true,
  "itm_rerank_num": 50,
  "model_type": "gram_lora",
  "use_lora": true,
  "lora_r_vision": 8,
  "lora_r_audio": 8,
  "lora_r_text": 8,
  "lora_alpha": 16,
  "eval_mask_rate": 0.9,
  "eval_mask_seed": 0,
  "max_caption_len": 70
 },
 "data_cfg": {
  "train": [
   {
    "type": "annoindexed",
    "training": false,
    "name": "didemo_ret",
    "txt": "datasets/annotations/didemo/descs_ret_test.json",
    "vision": "${DATA_ROOT}/DiDeMo/videos_flat",
    "audio": "${DATA_ROOT}/DiDeMo/audios",
    "vision_format": "video_rawvideo",
    "vision_sample_num": 40,
    "audio_sample_num": 2,
    "task": "ret%tva",
    "n_workers": 8,
    "batch_size": 64
   }
  ],
  "val": [
   {
    "type": "annoindexed",
    "training": false,
    "name": "didemo_ret",
    "txt": "datasets/annotations/didemo/descs_ret_test.json",
    "vision": "${DATA_ROOT}/DiDeMo/videos_flat",
    "audio": "${DATA_ROOT}/DiDeMo/audios",
    "vision_format": "video_rawvideo",
    "vision_sample_num": 40,
    "audio_sample_num": 2,
    "task": "ret%tva",
    "n_workers": 8,
    "batch_size": 64
   }
  ]
 }
}