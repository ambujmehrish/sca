{
 "run_cfg": {
  "default": "./config/sca/default_run_cfg.json",
  "mode": "testing",
  "checkpoint": "${EVAL_CKPT}"
 },
 "model_cfg": {
  "default": "./config/sca/default_model_cfg.json",
  "vision_encoder_type": "evaclip01_giant",
  "ret_bidirection_evaluation": true,
  "itm_rerank_num": 50,
  "model_type": "pmrl",
  "score_mode": "pmrl_norm",
  "use_lora": false,
  "eval_mask_rate": 0.9,
  "eval_mask_seed": 0
 },
 "data_cfg": {
  "train": [
   {
    "type": "annoindexed",
    "training": false,
    "name": "vatex_ret",
    "txt": "datasets/annotations/vatex/descs_ret_test_431.json",
    "vision": "${DATA_ROOT}/VATEX/videos_raw",
    "audio": "${DATA_ROOT}/VATEX/audios",
    "vision_format": "video_rawvideo",
    "vision_sample_num": 8,
    "audio_sample_num": 1,
    "task": "ret%tvas",
    "n_workers": 8,
    "batch_size": 64
   }
  ],
  "val": [
   {
    "type": "annoindexed",
    "training": false,
    "name": "vatex_ret",
    "txt": "datasets/annotations/vatex/descs_ret_test_431.json",
    "vision": "${DATA_ROOT}/VATEX/videos_raw",
    "audio": "${DATA_ROOT}/VATEX/audios",
    "vision_format": "video_rawvideo",
    "vision_sample_num": 8,
    "audio_sample_num": 1,
    "task": "ret%tvas",
    "n_workers": 8,
    "batch_size": 64
   }
  ]
 }
}
