{
 "run_cfg": {
  "default": "./config/gram/default_run_cfg.json",
  "mode": "testing",
  "checkpoint": "${EVAL_CKPT}"
 },
 "model_cfg": {
  "default": "./config/gram/default_model_cfg.json",
  "vision_encoder_type": "evaclip01_giant",
  "model_type": "pmrl",
  "pmrl_variant": "raw",
  "pmrl_ortho_w": 0.1,
  "pmrl_temp": 0.07,
  "score_mode": "pmrl_raw",
  "use_lora": true,
  "lora_r_vision": 8,
  "lora_r_audio": 8,
  "lora_r_text": 8,
  "lora_alpha": 16
 },
 "data_cfg": {
  "train": [
   {
    "type": "annoindexed",
    "training": false,
    "name": "msrvtt_ret",
    "txt": "datasets/annotations/msrvtt/descs_ret_test.json",
    "vision_transforms": "crop_flip",
    "vision_format": "video_rawvideo",
    "vision": "${DATA_ROOT}/MSRVTT_full/MSRVTT/videos/all",
    "audio": "${DATA_ROOT}/MSRVTT_full/audios",
    "vision_sample_num": 8,
    "audio_sample_num": 1,
    "task": "ret%tvas",
    "n_workers": 8,
    "batch_size": 32
   }
  ],
  "val": [
   {
    "type": "annoindexed",
    "training": false,
    "name": "msrvtt_ret",
    "txt": "datasets/annotations/msrvtt/descs_ret_test.json",
    "vision_transforms": "crop_flip",
    "vision_format": "video_rawvideo",
    "vision": "${DATA_ROOT}/MSRVTT_full/MSRVTT/videos/all",
    "audio": "${DATA_ROOT}/MSRVTT_full/audios",
    "vision_sample_num": 8,
    "audio_sample_num": 1,
    "task": "ret%tvas",
    "n_workers": 8,
    "batch_size": 32
   }
  ]
 }
}